# Local SQLite database. The path is relative to the prisma folder.
DATABASE_URL="file:./dev.db"

# Signs the session cookie. Use a long random string before any shared deployment.
AUTH_SECRET="replace-with-a-random-string-at-least-32-characters"

# Demo sign-in created by prisma db seed. This is a fictional local account.
DEMO_USER_EMAIL="demo@bai-khiao.example"
DEMO_USER_PASSWORD="Demo1234!"
DEMO_USER_NAME="นักบัญชีตัวอย่าง"

# Chrome or Chromium is used only to render Thai PDFs. Leave blank to try common paths.
CHROME_PATH=""
