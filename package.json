{
  "name": "bai-khiao-books",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/patch-prisma-worker.mjs && VINEXT=1 vite build && node scripts/patch-wrangler-output.mjs",
    "build:next": "next build",
    "dev:vinext": "VINEXT=1 vite dev --port 3001",
    "preview": "npm run build && wrangler d1 migrations apply bai-khiao --local --config dist/server/wrangler.json --persist-to .wrangler/state && wrangler dev --config dist/server/wrangler.json --port 8787 --persist-to .wrangler/state",
    "deploy": "npm run build && vinext-cloudflare deploy --config dist/server/wrangler.json",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "setup": "prisma migrate deploy && prisma db seed",
    "postinstall": "prisma generate && node scripts/patch-prisma-worker.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-better-sqlite3": "^6.19.3",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.0",
    "@vinext/cloudflare": "^1.3.4",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "fontkit": "^3.0.0",
    "jose": "^6.1.0",
    "next": "^15.5.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^3.2.4",
    "wrangler": "^4.160.1"
  },
  "type": "module"
}
