{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bai-khiao",
  "account_id": "2141c75d142de588f4d6f28bf197a08e",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  // Prisma's query compiler is a precompiled Wasm module. Workers reject
  // WebAssembly.Module() / WebAssembly.compile() at runtime.
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "main": "vinext/server/fetch-handler",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  // Production Workers do not seed demo data. Local `next dev` leaves APP_ENV unset.
  "vars": {
    "APP_ENV": "production"
  },
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bai-khiao",
      // Replace this placeholder on the first real deploy. scripts/provision-cloudflare.mjs
      // writes the id returned by `wrangler d1 create` before remote migrations run.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "bai-khiao-files"
    }
  ]
}
